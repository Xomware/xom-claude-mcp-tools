# GitHub Configuration
GITHUB_TOKEN=ghp_your_token_here
GITHUB_APP_ID=your_app_id
GITHUB_APP_PRIVATE_KEY=your_private_key

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your_signing_secret
SLACK_APP_ID=your_app_id

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xomware
DB_USER=postgres
DB_PASSWORD=password
DB_DRIVER=postgresql

# Xomware API Configuration
XOMWARE_API_URL=https://api.xomware.com
XOMWARE_API_KEY=your_api_key_here
XOMWARE_AUTH_HASH=your_auth_hash_here

# Security
ENCRYPTION_KEY=your_encryption_key_here
JWT_SECRET=your_jwt_secret_here
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Monitoring
SENTRY_DSN=https://your_sentry_dsn
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Feature Flags
ENABLE_PR_REVIEW=true
ENABLE_ISSUE_MANAGEMENT=true
ENABLE_CODE_ANALYSIS=true
ENABLE_SLACK_NOTIFICATIONS=true
ENABLE_DATABASE_QUERIES=true
