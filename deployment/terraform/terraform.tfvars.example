aws_region   = "us-east-1"
environment  = "dev"

# VPC Configuration
vpc_id            = "vpc-12345678"
alb_subnets       = ["subnet-12345678", "subnet-87654321"]
database_subnets  = ["subnet-11111111", "subnet-22222222"]

# RDS Configuration
db_instance_class = "db.t3.micro"
db_storage        = 20
db_multi_az       = false

# ECS Configuration
ecs_instance_type = "t3.micro"
ecs_desired_count = 2

# Sensitive values (set via environment variables or terraform.tfvars)
# github_token = "ghp_your_token_here"
# slack_bot_token = "xoxb-your-token-here"
# xomware_api_key = "your_api_key_here"

# Tags
tags = {
  Project    = "xom-mcp-tools"
  ManagedBy  = "terraform"
  Owner      = "xomware"
}
